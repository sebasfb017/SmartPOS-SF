generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Business {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  products    Product[]
  sales       Sale[]
  payroll     PayrollRecord[]
}

model User {
  id         String   @id @default(uuid())
  name       String
  username   String   @unique
  password   String   // In a real app, this should be hashed
  role       String   @default("CASHIER") // ADMIN, CASHIER
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  sales      Sale[]
  payroll    PayrollRecord[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessId  String
  business    Business @relation(fields: [businessId], references: [id])

  saleItems   SaleItem[]
}

model Sale {
  id         String   @id @default(uuid())
  total      Float
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  items      SaleItem[]
}

model SaleItem {
  id         String   @id @default(uuid())
  quantity   Int
  price      Float    // Price at the time of sale

  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id])

  productId  String
  product    Product  @relation(fields: [productId], references: [id])
}

model PayrollRecord {
  id          String   @id @default(uuid())
  date        DateTime
  amount      Float
  type        String   // HOURLY, SALARY, COMMISSION
  notes       String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
}
